# TikTokHistoryFactory - Variables environnement
# Copier en .env, NE JAMAIS commiter .env

DB_PATH=data/factory.db
LOG_LEVEL=INFO
LOG_DIR=logs

FFMPEG_PATH=C:\TikTokHistoryFactory\ffmpeg\bin\ffmpeg.exe
FFPROBE_PATH=C:\TikTokHistoryFactory\ffmpeg\bin\ffprobe.exe
COMFYUI_BASE_URL=http://127.0.0.1:8188
PIPER_MODEL_PATH=C:/TikTokHistoryFactory/tools/piper/voices/en_US-john-medium.onnx
COMFYUI_CHECKPOINT=sd_xl_base_1.0.safetensors
PILOT_DOSSIER=C:/TikTokHistoryFactory/data/subjects/thiaroye-1944-v2.json

TIKTOK_PUBLISH_MODE=LOCAL_EXPORT
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_PUBLISH_ENABLED=false

WIKIPEDIA_USER_AGENT=TikTokHistoryFactory/0.2 (local historical research)
GOOGLE_API_KEY=

MAX_DAILY_VIDEOS=3
MAX_RETRY_ATTEMPTS=3
TASK_TIMEOUT_SECONDS=1800

OLLAMA_BASE_URL=http://127.0.0.1:11434/api
OLLAMA_MODEL=kimi-k3:cloud
OLLAMA_API_KEY=

OLLAMA_LOCAL_URL=http://localhost:11434
OLLAMA_LOCAL_MODEL=gemma3:4b

KWH_PRICE_EUR=0.20

# V2: spoken English, French translation captions, no permanent AI overlay
SPOKEN_LANGUAGE=en-US
SUBTITLE_LANGUAGE=fr-FR
TRANSLATION_LOCALE=fr-FR
TTS_LENGTH_SCALE=1.0
COMFYUI_LORA=LineAniRedmondV2-Lineart-LineAniAF.safetensors
COMFYUI_LORA_STRENGTH=1.0
